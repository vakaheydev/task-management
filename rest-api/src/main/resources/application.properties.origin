# ============================
#           Spring
# ============================

# ============================
#           Server
# ============================
server.port=${REST_API_PORT:8080}
server.forward-headers-strategy=framework

# ============================
#         Data Source
# ============================
spring.datasource.url=
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=org.postgresql.Driver

# ============================
#             JPA
# ============================
spring.jpa.hibernate.ddl-auto=none
spring.jpa.properties.hibernate.event.merge.entity_copy_observer=allow

#         OAuth2 / MCP
# ============================
oauth2.issuer=${OAUTH2_ISSUER:https://vaka-daily.ru}

# Claude
oauth2.claude.client.id=${OAUTH2_CLIENT_ID:claude-mcp-client}
oauth2.claude.client.secret=${OAUTH2_CLIENT_SECRET:change-this-secret}
oauth2.claude.client.redirect-uri=${OAUTH2_REDIRECT_URI:https://claude.ai/api/mcp/auth_callback}

# ChatGPT
oauth2.chatgpt.client.id=${OAUTH2_CHATGPT_CLIENT_ID:chatgpt-mcp-client}
oauth2.chatgpt.client.secret=${OAUTH2_CHATGPT_CLIENT_SECRET:change-this-secret}
oauth2.chatgpt.client.redirect-uri=${OAUTH2_CHATGPT_REDIRECT_URI:https://chatgpt.com/connector/oauth/3UjaNb_hFp4T}

# ============================
#           MCP Server
# ============================
spring.ai.mcp.server.enabled=true
spring.ai.mcp.server.name=task-management
spring.ai.mcp.server.version=1.0.0
spring.ai.mcp.server.type=SYNC
spring.ai.mcp.server.sse-message-endpoint=/mcp/message

# ============================
#           Logging
# ============================
logging.level.org.springframework.web.filter.CommonsRequestLoggingFilter=WARN
logging.level.org.springframework.http.converter.json=DEBUG
logging.level.com.vaka.daily=INFO

# ============================
#           Telegram
# ============================
telegram.bot.url=http://${TG_BOT_HOST:localhost}:${TG_BOT_PORT:8889}/api
telegram.enabled=${TG_BOT_ENABLED:true}
telegram.binding.enabled=${TG_BINDING_ENABLED:true}

# ============================
#         Notification
# ============================
notificaton.enabled=${NOTIFICATION_ENABLED:true}

# ============================
#             Security / JWT
# ============================
# Secret used to sign JWT tokens (override in environment for production)
jwt.secret=${JWT_SECRET}
# Token validity in milliseconds (e.g. 3600000 = 1 hour, 86400000 = 1 day (24 hours))
jwt.expiration=${JWT_EXPIRATION:86400000}
